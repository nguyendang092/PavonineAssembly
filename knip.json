{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "vite": true,
  "paths": {
    "@/*": ["./src/*"]
  },
  "entry": [
    "src/**/*.test.js",
    "server/**/*.test.mjs",
    "functions/**/*.test.mjs",
    "functions/index.js"
  ],
  "project": [
    "src/**/*.{js,jsx}",
    "server/**/*.mjs",
    "functions/**/*.{js,mjs}"
  ]
}
